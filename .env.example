# Copy to .env.local and fill in — never commit real keys.

# Server-side key for the Axom Assistant (/api/assistant) and for
# model-based opportunity classification (/api/opportunities). Without it,
# both degrade gracefully: the Assistant returns "not configured" and
# opportunity scoring falls back to the deterministic keyword tagger.
ANTHROPIC_API_KEY=

# Set to "live" to pull real opportunities from Grants.gov + SAM.gov.
# Unset (or any other value) uses the bundled mock data.
NEXT_PUBLIC_DATA_PROVIDER=

# Optional: free API key from your SAM.gov account profile
# (Account Details → API Key). Without it, live mode still works
# with Grants.gov only.
SAM_GOV_API_KEY=
